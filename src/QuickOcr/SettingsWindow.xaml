<Window x:Class="QuickOcr.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick OCR &#35373;&#23450;"
        Width="780"
        Height="500"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F7"
        Icon="Assets/QuickOcr.ico">
    <Window.Resources>
        <DropShadowEffect x:Key="ControlShadow"
                          BlurRadius="14"
                          ShadowDepth="3"
                          Opacity="0.14" />

        <Style x:Key="FieldTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#161616" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="#DFFFFFFF" />
            <Setter Property="BorderBrush" Value="#8EA7C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="#DFFFFFFF" />
            <Setter Property="BorderBrush" Value="#8EA7C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid>
                                                <Path Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#3A3A3A"
                                                      StrokeThickness="1.6"
                                                      Width="10"
                                                      Height="6"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,14,0" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        Background="#F2FFFFFF"
                                        BorderBrush="#8EA7C8"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="Assets/SettingsBackground.png"
               Stretch="UniformToFill"
               Opacity="1" />

        <Rectangle Fill="#48FFFFFF" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#28FFFFFF" Offset="0" />
                    <GradientStop Color="#08FFFFFF" Offset="0.55" />
                    <GradientStop Color="#18FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="42,46,42,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="&#35373;&#23450;"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#111111" />

            <Grid Grid.Row="1" Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="&#12471;&#12519;&#12540;&#12488;&#12459;&#12483;&#12488;&#12461;&#12540;"
                           Style="{StaticResource FieldTextStyle}" />
                <TextBox x:Name="HotkeyTextBox"
                         Grid.Column="1"
                         IsReadOnly="True"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown">
                    <TextBox.Effect>
                        <StaticResource ResourceKey="ControlShadow" />
                    </TextBox.Effect>
                </TextBox>

                <TextBlock Grid.Row="1"
                           Text="OCR&#35328;&#35486;"
                           Margin="0,28,0,0"
                           Style="{StaticResource FieldTextStyle}" />
                <ComboBox x:Name="LanguageComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,28,0,0"
                          SelectedValuePath="Tag"
                          Style="{StaticResource RoundedComboBoxStyle}">
                    <ComboBox.Effect>
                        <StaticResource ResourceKey="ControlShadow" />
                    </ComboBox.Effect>
                    <ComboBoxItem Content="&#33258;&#21205;" Tag="Auto" />
                    <ComboBoxItem Content="&#26085;&#26412;&#35486;" Tag="Japanese" />
                    <ComboBoxItem Content="&#33521;&#35486;" Tag="English" />
                    <ComboBoxItem Content="&#20013;&#22269;&#35486;" Tag="Chinese" />
                </ComboBox>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="210,22,0,0"
                       Text="&#20837;&#21147;&#27396;&#12434;&#12463;&#12522;&#12483;&#12463;&#12375;&#12390;&#12289;&#35373;&#23450;&#12375;&#12383;&#12356;&#12461;&#12540;&#12398;&#32068;&#12415;&#21512;&#12431;&#12379;&#12434;&#25276;&#12375;&#12390;&#12367;&#12384;&#12373;&#12356;&#12290;"
                       FontSize="15"
                       Foreground="#4D4D4D"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="4"
                        Margin="0,20,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="&#12461;&#12515;&#12531;&#12475;&#12523;"
                        Click="CancelButton_Click"
                        Background="#F7F7F7"
                        BorderBrush="#B8B8B8"
                        Foreground="#1D1D1D"
                        Style="{StaticResource SettingsButtonStyle}" />
                <Button Content="&#20445;&#23384;"
                        Click="SaveButton_Click"
                        Background="#0A70D8"
                        Foreground="#FFFFFF"
                        BorderBrush="#0A70D8"
                        Style="{StaticResource SettingsButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
